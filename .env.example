# Пример конфигурации. Скопируй в .env и поправь под себя:
#     cp .env.example .env
#
# Все переменные необязательны: если .env нет, shared/config.py возьмёт
# те же значения, что указаны здесь как дефолтные.
#
# ВАЖНО про docker compose: адреса LM Studio и STT внутри контейнера
# отличаются от локальных (host.docker.internal и stt вместо 127.0.0.1).
# Они заданы литерально в docker-compose.yml, поэтому переопределять
# LM_STUDIO_BASE_URL и STT_URL в .env для Docker НЕ нужно — значения
# отсюда на контейнер не влияют. Этот файл описывает локальный запуск.


# --- LM Studio (OpenAI-совместимый API) ---------------------------------

# Адрес LM Studio. URL с путём /v1.
# Локально: http://127.0.0.1:1234/v1
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# Ключ API. LM Studio его не проверяет, но клиент требует непустую строку,
# поэтому подойдёт любое значение.
LM_STUDIO_API_KEY=lm-studio

# Имя модели, загруженной в LM Studio. Копируется из поля
# "This model's API identifier" в интерфейсе LM Studio — если строка
# не совпадает посимвольно, локальный API вернёт 404.
MODEL_NAME=qwen/qwen3-8b


# --- STT (распознавание речи) -------------------------------------------

# Полный URL эндпоинта транскрибации, включая /transcribe.
# Локально сервис поднимается на порту 8000.
STT_URL=http://127.0.0.1:8000/transcribe


# --- RAG ----------------------------------------------------------------

# Модель эмбеддингов для FAISS-индекса, имя из HuggingFace.
# Выбрана по бенчмарку (benchmark/results.json): лучший recall@5 при
# вдвое меньшем размере, чем у e5-large.
#
# ВАЖНО: смена модели ТРЕБУЕТ пересборки индекса —
#     uv run python -m services.llm_service.rag.store
# Иначе load_index откажется работать: индекс, собранный другой моделью,
# не выдаёт ошибку при поиске, а молча возвращает неверные результаты.
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base

# Префиксы роли текста для семейства e5: модель обучена по-разному
# кодировать поисковый запрос и индексируемый документ, без префиксов
# качество падает. Запрос кодируется с EMBEDDING_QUERY_PREFIX, вопросы
# банка — с EMBEDDING_PASSAGE_PREFIX.
#
# Для модели не из семейства e5 (LaBSE, MiniLM и т.п.) оба префикса
# нужно погасить пустым значением:
#     EMBEDDING_QUERY_PREFIX=
#     EMBEDDING_PASSAGE_PREFIX=
# Смена префиксов, как и смена модели, требует пересборки индекса.
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "


# --- Пороги маршрутизации агента ----------------------------------------

# Число от 0.0 до 1.0. Оценка ответа ниже порога — агент задаёт
# уточняющий вопрос по той же теме вместо перехода к следующей.
DRIFT_SCORE_THRESHOLD=0.45

# Число от 0.0 до 1.0. Оценка выше порога при нуле пропущенных аспектов
# rubric — ответ считается засчитанным, агент идёт дальше.
ON_TOPIC_OVERRIDE_SCORE=0.80


# --- Порты для docker compose -------------------------------------------

# Порты на хосте, читаются только docker-compose.yml (не shared/config.py).
# Меняй, если 7860 или 8000 уже заняты.
WEB_PORT=7860
STT_PORT=8000
